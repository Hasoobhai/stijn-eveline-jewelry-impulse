{% doc %}
  @prompt
    <p>Need guidance? You can rely on us for straightforward assistance.</p>
    <p><strong>Email: </strong><a href="mailto:info@trevinae.com" title="info@trevinae.com">info@trevinae.com</a><strong><br>Phone Number: </strong><a href="tel:+31616165091" title="+31616165091">+31616165091</a><strong><br>Contact Form: </strong>Available on our <a href="/pages/contact-us" title="Contact Us">Contact Us</a> page</p>
    <p><strong>Customer Service Hours: </strong>Monday to Friday, 09:00-17:00 GMT</p>
    
    put his in a box customized with border and movement and somethin and make it editable in customjze, make it more creative and dont take all the width
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-info-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.alignment }};
    width: 100%;
  }

  .ai-contact-info-box-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: {{ block.settings.max_width }}px;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_gradient }};
    border: {{ block.settings.border_width }}px {{ block.settings.border_style }} {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_color }};
    position: relative;
    overflow: hidden;
    transition: all {{ block.settings.animation_duration }}s ease;
  }

  .ai-contact-info-box-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    background: {{ block.settings.accent_gradient }};
    border-radius: {{ block.settings.border_radius }}px;
    opacity: {{ block.settings.accent_opacity }};
    z-index: -1;
    transition: opacity {{ block.settings.animation_duration }}s ease;
  }

  .ai-contact-info-box-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 150px;
    height: 150px;
    background: {{ block.settings.decoration_color }};
    opacity: 0.1;
    border-radius: 50%;
    transform: translate(50%, -50%);
    pointer-events: none;
  }

  {% if block.settings.enable_hover_effect %}
    .ai-contact-info-box-{{ ai_gen_id }}:hover {
      transform: translateY({{ block.settings.hover_lift }}px) rotate({{ block.settings.hover_rotate }}deg);
      box-shadow: {{ block.settings.hover_shadow_x }}px {{ block.settings.hover_shadow_y }}px {{ block.settings.hover_shadow_blur }}px {{ block.settings.hover_shadow_color }};
    }

    .ai-contact-info-box-{{ ai_gen_id }}:hover::before {
      opacity: {{ block.settings.accent_hover_opacity }};
    }
  {% endif %}

  .ai-contact-info-box__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background: {{ block.settings.icon_background }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    color: {{ block.settings.icon_color }};
    font-size: {{ block.settings.icon_size | times: 0.5 }}px;
  }

  .ai-contact-info-box__content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.7;
    position: relative;
    z-index: 1;
  }

  .ai-contact-info-box__content-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px 0;
  }

  .ai-contact-info-box__content-{{ ai_gen_id }} p:first-child {
    font-size: {{ block.settings.text_size | times: 1.1 }}px;
    font-weight: 500;
  }

  .ai-contact-info-box__content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-contact-info-box__content-{{ ai_gen_id }} strong {
    color: {{ block.settings.heading_color }};
    font-weight: 600;
    display: inline-block;
    min-width: 140px;
  }

  .ai-contact-info-box__content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: all 0.3s ease;
    padding-bottom: 2px;
  }

  .ai-contact-info-box__content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
    border-bottom-color: {{ block.settings.link_hover_color }};
  }

  .ai-contact-info-box__divider-{{ ai_gen_id }} {
    height: 2px;
    background: {{ block.settings.divider_gradient }};
    margin: {{ block.settings.divider_spacing }}px 0;
    border-radius: 2px;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-info-wrapper-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-contact-info-box-{{ ai_gen_id }} {
      width: 95%;
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }

    .ai-contact-info-box__content-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-contact-info-box__content-{{ ai_gen_id }} strong {
      display: block;
      margin-bottom: 5px;
    }

    .ai-contact-info-box__icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-contact-info-wrapper-{{ ai_gen_id }}">
  <ai-contact-info-box-{{ ai_gen_id }} class="ai-contact-info-box-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    {% if block.settings.show_icon %}
      <div class="ai-contact-info-box__icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
      </div>
    {% endif %}

    <div class="ai-contact-info-box__content-{{ ai_gen_id }}">
      {% if block.settings.content != blank %}
        {{ block.settings.content }}
      {% else %}
        <p>Need guidance? You can rely on us for straightforward assistance.</p>
        
        {% if block.settings.show_divider %}
          <div class="ai-contact-info-box__divider-{{ ai_gen_id }}"></div>
        {% endif %}

        <p><strong>Email:</strong> <a href="mailto:info@trevinae.com">info@trevinae.com</a></p>
        <p><strong>Phone Number:</strong> <a href="tel:+31616165091">+31616165091</a></p>
        <p><strong>Contact Form:</strong> Available on our <a href="/pages/contact-us">Contact Us</a> page</p>
        
        {% if block.settings.show_divider %}
          <div class="ai-contact-info-box__divider-{{ ai_gen_id }}"></div>
        {% endif %}

        <p><strong>Service Hours:</strong> Monday to Friday, 09:00-17:00 GMT</p>
      {% endif %}
    </div>
  </ai-contact-info-box-{{ ai_gen_id }}>
</div>

<script>
  (function() {
    class AiContactInfoBox{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('ai-contact-info-box-{{ ai_gen_id }}', AiContactInfoBox{{ ai_gen_id }});
  })();
</script>

