{% doc %}
  @prompt
    <p><strong>How We Can Help</strong></p>
    <ul>
    <li><strong>Order Updates:</strong> Check the status of your order, including processing, shipping, and delivery information.</li>
    <li><strong>Product Information:</strong> Get details on item features and guidance on using products from our website.</li>
    <li><strong>Provide Feedback:</strong> Share your comments or suggestions regarding our services.</li>
    <li><strong>Store Inquiries:</strong> Find answers about our policies, procedures, and general questions about the store.</li>
    </ul>
    <p>Trevinae is owned and operated by Yano Ecom, a company registered in the Netherlands.</p>
    <p><strong>Registration Number:</strong> 95697446</p>
    <p><strong>Address:</strong> Jan Voermanstraat 100, 2, 1061 XK Amsterdam, Netherlands</p>
    <p>Need guidance? You can rely on us for straightforward assistance.</p>
    <p><strong>Email: </strong><a href="mailto:info@trevinae.com" title="info@trevinae.com">info@trevinae.com</a><strong><br>Phone Number: </strong><a href="tel:+31616165091" title="+31616165091">+31616165091</a><strong><br>Contact Form: </strong>Available on our <a href="/pages/contact-us" title="Contact Us">Contact Us</a> page</p>
    <p><strong>Customer Service Hours: </strong>Monday to Friday, 09:00-17:00 GMT</p>
    
    customize those in boxes or something creative and use borders, colors, movement hovering, creativity and dont chanega ny word and make them editable in customize, put the how we can help in a line and under put the company info in a box and the contact info in another box
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-info-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-contact-info__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-contact-info__full-width-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border: {{ block.settings.border_width }}px {{ block.settings.border_style }} {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    margin-bottom: {{ block.settings.card_spacing }}px;
    transition: all {{ block.settings.animation_speed }}s ease;
    box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_color }};
  }

  .ai-contact-info__full-width-{{ ai_gen_id }}:hover {
    transform: translateY({{ block.settings.hover_lift }}px);
    border-color: {{ block.settings.hover_border_color }};
    box-shadow: {{ block.settings.hover_shadow_x }}px {{ block.settings.hover_shadow_y }}px {{ block.settings.hover_shadow_blur }}px {{ block.settings.hover_shadow_color }};
  }

  .ai-contact-info__two-column-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.card_spacing }}px;
  }

  .ai-contact-info__card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border: {{ block.settings.border_width }}px {{ block.settings.border_style }} {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    transition: all {{ block.settings.animation_speed }}s ease;
    box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_color }};
  }

  .ai-contact-info__card-{{ ai_gen_id }}:hover {
    transform: translateY({{ block.settings.hover_lift }}px);
    border-color: {{ block.settings.hover_border_color }};
    box-shadow: {{ block.settings.hover_shadow_x }}px {{ block.settings.hover_shadow_y }}px {{ block.settings.hover_shadow_blur }}px {{ block.settings.hover_shadow_color }};
  }

  .ai-contact-info__card-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
  }

  .ai-contact-info__card-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.line_height }};
  }

  .ai-contact-info__card-content-{{ ai_gen_id }} ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-contact-info__card-content-{{ ai_gen_id }} li {
    margin-bottom: {{ block.settings.list_spacing }}px;
    padding-left: 20px;
    position: relative;
  }

  .ai-contact-info__card-content-{{ ai_gen_id }} li:before {
    content: "{{ block.settings.bullet_icon }}";
    position: absolute;
    left: 0;
    color: {{ block.settings.accent_color }};
  }

  .ai-contact-info__card-content-{{ ai_gen_id }} strong {
    color: {{ block.settings.strong_color }};
    font-weight: {{ block.settings.strong_weight }};
  }

  .ai-contact-info__card-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: {{ block.settings.link_decoration }};
    transition: color {{ block.settings.animation_speed }}s ease;
  }

  .ai-contact-info__card-content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-contact-info__card-content-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px 0;
  }

  .ai-contact-info__card-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-info__two-column-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<contact-info-{{ ai_gen_id }} class="ai-contact-info-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-info__container-{{ ai_gen_id }}">
    <div class="ai-contact-info__full-width-{{ ai_gen_id }}">
      <h3 class="ai-contact-info__card-title-{{ ai_gen_id }}">{{ block.settings.card_1_title }}</h3>
      <div class="ai-contact-info__card-content-{{ ai_gen_id }}">
        {{ block.settings.card_1_content }}
      </div>
    </div>

    <div class="ai-contact-info__two-column-{{ ai_gen_id }}">
      <div class="ai-contact-info__card-{{ ai_gen_id }}">
        <h3 class="ai-contact-info__card-title-{{ ai_gen_id }}">{{ block.settings.card_2_title }}</h3>
        <div class="ai-contact-info__card-content-{{ ai_gen_id }}">
          {{ block.settings.card_2_content }}
        </div>
      </div>

      <div class="ai-contact-info__card-{{ ai_gen_id }}">
        <h3 class="ai-contact-info__card-title-{{ ai_gen_id }}">{{ block.settings.card_3_title }}</h3>
        <div class="ai-contact-info__card-content-{{ ai_gen_id }}">
          {{ block.settings.card_3_content }}
        </div>
      </div>
    </div>
  </div>
</contact-info-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactInfo{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-contact-info__card-{{ ai_gen_id }}, .ai-contact-info__full-width-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.cards.forEach((card) => {
          card.setAttribute('tabindex', '0');
        });
      }
    }

    customElements.define('contact-info-{{ ai_gen_id }}', ContactInfo{{ ai_gen_id }});
  })();
</script>

