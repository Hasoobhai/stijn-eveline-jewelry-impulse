{% doc %}
  @prompt
    <p><strong>Order Cancellations</strong><br>To cancel an order, contact us promptly at <a href="mailto:info@trevinae.com" title="info@trevinae.com">info@trevinae.com</a>. Cancellations are only possible if the order has not yet entered the processing stage. <span>If you no longer want to keep the item after delivery, you can request a return by following the return steps and requirements.</span></p>
    <p><strong>Damaged or Incorrect Items</strong><br>If you receive an item that is damaged or incorrect, email <a href="mailto:info@trevinae.com" title="info@trevinae.com">info@trevinae.com</a> including:</p>
    <ul>
    <li>Your order number</li>
    <li>A brief description of the issue</li>
    <li>Photos of the item and its packaging</li>
    </ul>
    <p>Once reviewed, you can request a <strong>replacement</strong> or a <strong>full refund</strong>.</p>
    put those in two customized boxes creative and decorative and make them editable in customize
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-policy-boxes-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }

  .ai-policy-boxes__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }

  @media screen and (min-width: 750px) {
    .ai-policy-boxes__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
    }
  }

  .ai-policy-box-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.box_background }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.box_padding }}px;
    box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    overflow: hidden;
  }

  .ai-policy-box-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: {{ block.settings.shadow_horizontal | times: 1.5 }}px {{ block.settings.shadow_vertical | times: 1.5 }}px {{ block.settings.shadow_blur | times: 1.5 }}px {{ block.settings.shadow_color }};
  }

  .ai-policy-box-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: {{ block.settings.accent_height }}px;
    background: {{ block.settings.accent_color }};
  }

  .ai-policy-box__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    margin-top: {{ block.settings.accent_height }}px;
  }

  .ai-policy-box__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.icon_background }};
    border-radius: 50%;
    padding: 15px;
  }

  .ai-policy-box__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: {{ block.settings.icon_color }};
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-policy-box__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 15px 0;
    line-height: 1.3;
  }

  .ai-policy-box__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin-bottom: 15px;
  }

  .ai-policy-box__text-{{ ai_gen_id }} p {
    margin: 0 0 12px 0;
  }

  .ai-policy-box__text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-policy-box__text-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .ai-policy-box__text-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-policy-box__text-{{ ai_gen_id }} ul {
    margin: 10px 0;
    padding-left: 20px;
  }

  .ai-policy-box__text-{{ ai_gen_id }} li {
    margin-bottom: 8px;
    line-height: 1.6;
  }

  .ai-policy-box__text-{{ ai_gen_id }} strong {
    font-weight: 700;
    color: {{ block.settings.title_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-policy-boxes-{{ ai_gen_id }} {
      padding: 15px;
    }

    .ai-policy-box-{{ ai_gen_id }} {
      padding: {{ block.settings.box_padding | times: 0.75 }}px;
    }

    .ai-policy-box__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }

    .ai-policy-box__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<policy-boxes-{{ ai_gen_id }} class="ai-policy-boxes-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-policy-boxes__container-{{ ai_gen_id }}">
    
    <div class="ai-policy-box-{{ ai_gen_id }}">
      <div class="ai-policy-box__content-{{ ai_gen_id }}">
        {% if block.settings.show_icon_1 %}
          <div class="ai-policy-box__icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
        {% endif %}
        
        {% if block.settings.box_1_title != blank %}
          <h3 class="ai-policy-box__title-{{ ai_gen_id }}">{{ block.settings.box_1_title }}</h3>
        {% endif %}
        
        {% if block.settings.box_1_content != blank %}
          <div class="ai-policy-box__text-{{ ai_gen_id }}">
            {{ block.settings.box_1_content }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-policy-box-{{ ai_gen_id }}">
      <div class="ai-policy-box__content-{{ ai_gen_id }}">
        {% if block.settings.show_icon_2 %}
          <div class="ai-policy-box__icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
        {% endif %}
        
        {% if block.settings.box_2_title != blank %}
          <h3 class="ai-policy-box__title-{{ ai_gen_id }}">{{ block.settings.box_2_title }}</h3>
        {% endif %}
        
        {% if block.settings.box_2_content != blank %}
          <div class="ai-policy-box__text-{{ ai_gen_id }}">
            {{ block.settings.box_2_content }}
          </div>
        {% endif %}
      </div>
    </div>

  </div>
</policy-boxes-{{ ai_gen_id }}>

<script>
  (function() {
    class PolicyBoxes{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.enhanceAccessibility();
      }

      enhanceAccessibility() {
        const boxes = this.querySelectorAll('.ai-policy-box-{{ ai_gen_id }}');
        boxes.forEach((box, index) => {
          box.setAttribute('role', 'article');
          box.setAttribute('aria-label', `Policy information ${index + 1}`);
        });
      }
    }

    customElements.define('policy-boxes-{{ ai_gen_id }}', PolicyBoxes{{ ai_gen_id }});
  })();
</script>

