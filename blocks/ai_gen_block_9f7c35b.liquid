{% doc %}
  @prompt
    30-day Return Period
    Items can be returned within 30 days of delivery. Returns outside this period cannot be accepted.
    
    For more information, check our Return and Refund Policy.
    
    Customer Service
    Customer Service Hours: Monday to Friday, 09:00–17:00 GMT
    
    You can reach out through the options listed on our Contact Us page.
    
    Free Shipping
    Trevinae offers free shipping within the United Kingdom.
    
    For more information, check our Shipping Policy.
    
    put those 3 in 3 columns with icons using colors, icons that matches, borders, hovering movement
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-info-columns-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-info-columns__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-info-columns__column-{{ ai_gen_id }} {
    background-color: {{ block.settings.column_bg_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.column_padding }}px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-info-columns__column-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_lift | times: 2 }}px {{ block.settings.hover_lift | times: 4 }}px rgba(0, 0, 0, 0.1);
  }

  .ai-info-columns__icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_bg_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .ai-info-columns__icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-info-columns__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 12px 0;
  }

  .ai-info-columns__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-info-columns__link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-info-columns__link-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 989px) {
    .ai-info-columns__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
{% endstyle %}

<info-columns-{{ ai_gen_id }} class="ai-info-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-info-columns__container-{{ ai_gen_id }}">
    <div class="ai-info-columns__column-{{ ai_gen_id }}">
      <div class="ai-info-columns__icon-wrapper-{{ ai_gen_id }}">
        <svg class="ai-info-columns__icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
      </div>
      <h3 class="ai-info-columns__title-{{ ai_gen_id }}">30-day Return Period</h3>
      <p class="ai-info-columns__text-{{ ai_gen_id }}">
        Items can be returned within 30 days of delivery. Returns outside this period cannot be accepted.<br><br>
        For more information, check our <a href="{{ block.settings.return_policy_link }}" title="Return and Refund Policy" class="ai-info-columns__link-{{ ai_gen_id }}">Return and Refund Policy</a>.
      </p>
    </div>

    <div class="ai-info-columns__column-{{ ai_gen_id }}">
      <div class="ai-info-columns__icon-wrapper-{{ ai_gen_id }}">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  <rect x="2" y="6" width="20" height="14" rx="2" ry="2"></rect>
  <path d="M2 10h20"></path>
  <circle cx="18" cy="13" r="1.5"></circle>
</svg>

      </div>
      <h3 class="ai-info-columns__title-{{ ai_gen_id }}">Secure Payments</h3>
      <p class="ai-info-columns__text-{{ ai_gen_id }}">
        Payments are processed through established providers.<br><br>
        For complete guidance, please see our <u><a href="/pages/payment-policy" title="Payment Policy" class="ai-info-columns__link-{{ ai_gen_id }}">Payment Policy</a></u> Page.
      </p>
    </div>

    <div class="ai-info-columns__column-{{ ai_gen_id }}">
      <div class="ai-info-columns__icon-wrapper-{{ ai_gen_id }}">
        <svg class="ai-info-columns__icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
      </div>
      <h3 class="ai-info-columns__title-{{ ai_gen_id }}">Free Shipping</h3>
      <p class="ai-info-columns__text-{{ ai_gen_id }}">
        Trevinae offers free shipping within the United Kingdom.<br><br>
        For more information, check our <a href="{{ block.settings.shipping_policy_link }}" title="Shipping Policy" class="ai-info-columns__link-{{ ai_gen_id }}">Shipping Policy</a>.
      </p>
    </div>
  </div>
</info-columns-{{ ai_gen_id }}>

<script>
  (function() {
    class InfoColumns{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.columns = this.querySelectorAll('.ai-info-columns__column-{{ ai_gen_id }}');
      }
    }

    customElements.define('info-columns-{{ ai_gen_id }}', InfoColumns{{ ai_gen_id }});
  })();
</script>

