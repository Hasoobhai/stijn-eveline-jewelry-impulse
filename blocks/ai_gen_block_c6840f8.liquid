{% doc %}
  @prompt
    create 3 boxes and  want to put insinde the boxes texts with titlesand next to each one an image 
    customize the boxes like two borders for each box and that moves with the imgaes when hovering and make them editable in customize an use colors, amke them below eahc other, put the images outside the boxes and change the design
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-info-boxes-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-info-boxes__container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-info-box-{{ ai_gen_id }} {
    display: flex;
    gap: 30px;
    align-items: center;
  }

  .ai-info-box-{{ ai_gen_id }}:nth-child(even) {
    flex-direction: row-reverse;
  }

  .ai-info-box__image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 45%;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    transition: transform 0.4s ease;
  }

  .ai-info-box-{{ ai_gen_id }}:hover .ai-info-box__image-wrapper-{{ ai_gen_id }} {
    transform: translateY(-10px);
  }

  .ai-info-box__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s ease;
  }

  .ai-info-box-{{ ai_gen_id }}:hover .ai-info-box__image-{{ ai_gen_id }} {
    {% if block.settings.image_hover_scale == '1' %}
      transform: scale(1);
    {% elsif block.settings.image_hover_scale == '1.1' %}
      transform: scale(1.1);
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }

  .ai-info-box__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-info-box__image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-info-box__content-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    padding: 40px;
    background-color: {{ block.settings.box_background_color }};
    border-radius: {{ block.settings.box_border_radius }}px;
    transition: all 0.4s ease;
  }

  .ai-info-box-{{ ai_gen_id }}:hover .ai-info-box__content-{{ ai_gen_id }} {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }

  .ai-info-box__content-{{ ai_gen_id }}::before,
  .ai-info-box__content-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    border-radius: {{ block.settings.box_border_radius }}px;
    transition: all 0.4s ease;
  }

  .ai-info-box__content-{{ ai_gen_id }}::before {
    top: -{{ block.settings.border_offset }}px;
    left: -{{ block.settings.border_offset }}px;
    right: -{{ block.settings.border_offset }}px;
    bottom: -{{ block.settings.border_offset }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color_1 }};
    z-index: -1;
  }

  .ai-info-box__content-{{ ai_gen_id }}::after {
    top: {{ block.settings.border_offset }}px;
    left: {{ block.settings.border_offset }}px;
    right: {{ block.settings.border_offset }}px;
    bottom: {{ block.settings.border_offset }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color_2 }};
    z-index: -1;
  }

  .ai-info-box-{{ ai_gen_id }}:hover .ai-info-box__content-{{ ai_gen_id }}::before {
    top: -{{ block.settings.border_offset | plus: 4 }}px;
    left: -{{ block.settings.border_offset | plus: 4 }}px;
    right: -{{ block.settings.border_offset | plus: 4 }}px;
    bottom: -{{ block.settings.border_offset | plus: 4 }}px;
  }

  .ai-info-box-{{ ai_gen_id }}:hover .ai-info-box__content-{{ ai_gen_id }}::after {
    top: {{ block.settings.border_offset | plus: 4 }}px;
    left: {{ block.settings.border_offset | plus: 4 }}px;
    right: {{ block.settings.border_offset | plus: 4 }}px;
    bottom: {{ block.settings.border_offset | plus: 4 }}px;
  }

  .ai-info-box__text-section-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-info-box__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    font-weight: 600;
    line-height: 1.2;
  }

  .ai-info-box__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-info-boxes__container-{{ ai_gen_id }} {
      gap: 30px;
    }

    .ai-info-box-{{ ai_gen_id }},
    .ai-info-box-{{ ai_gen_id }}:nth-child(even) {
      flex-direction: column;
    }

    .ai-info-box__image-wrapper-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: 100%;
    }

    .ai-info-box__content-{{ ai_gen_id }} {
      padding: 25px;
    }
  }
{% endstyle %}

<info-boxes-{{ ai_gen_id }} class="ai-info-boxes-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-info-boxes__container-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign title_key = 'box_' | append: i | append: '_title'
        assign text_key = 'box_' | append: i | append: '_text'
        assign image_key = 'box_' | append: i | append: '_image'
        
        assign box_title = block.settings[title_key]
        assign box_text = block.settings[text_key]
        assign box_image = block.settings[image_key]
      %}
      
      <div class="ai-info-box-{{ ai_gen_id }}">
        <div class="ai-info-box__image-wrapper-{{ ai_gen_id }}">
          {% if box_image %}
            <img
              src="{{ box_image | image_url: width: 800 }}"
              alt="{{ box_image.alt | escape }}"
              class="ai-info-box__image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ box_image.width }}"
              height="{{ box_image.height }}"
            >
          {% else %}
            <div class="ai-info-box__image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-info-box__content-{{ ai_gen_id }}">
          <div class="ai-info-box__text-section-{{ ai_gen_id }}">
            {% if box_title != blank %}
              <h3 class="ai-info-box__title-{{ ai_gen_id }}">{{ box_title }}</h3>
            {% endif %}
            
            {% if box_text != blank %}
              <div class="ai-info-box__description-{{ ai_gen_id }}">{{ box_text }}</div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</info-boxes-{{ ai_gen_id }}>

<script>
  (function() {
    class InfoBoxes{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.boxes = this.querySelectorAll('.ai-info-box-{{ ai_gen_id }}');
      }
    }

    customElements.define('info-boxes-{{ ai_gen_id }}', InfoBoxes{{ ai_gen_id }});
  })();
</script>

