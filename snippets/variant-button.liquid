{%- assign swatch_file_extension = 'png' -%}

{%- capture size_chart_title -%}
  {{ 'products.general.size_chart' | t }} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-size-chart" viewBox="0 0 64 64"><path d="M22.39 33.53c-7.46 0-13.5-3.9-13.5-8.72s6-8.72 13.5-8.72 13.5 3.9 13.5 8.72a12 12 0 0 1-.22 1.73"/><ellipse cx="22.39" cy="24.81" rx="3.28" ry="2.12"/><path d="M8.89 24.81V38.5c0 7.9 6.4 9.41 14.3 9.41h31.92V33.53H22.39m24.39 0v7.44m-8.13-7.44v7.44m-8.13-7.44v7.44m-8.13-7.44v7.44"/></svg>
{%- endcapture -%}

{%- liquid
  assign is_size = false
  assign size_trigger = 'products.general.size_trigger' | t | downcase
  assign downcased_option = option.name | downcase

  if downcased_option contains size_trigger
    assign is_size = true
  endif
-%}

{% comment %} ── Tooltip styles (injected once per page via Liquid unless already present) ── {% endcomment %}
<style>
  /* ── Swatch tooltip wrapper ── */
  .variant-input {
    position: relative;
    display: inline-block;
  }

  /* The tooltip bubble */
  .variant-input .swatch-tooltip {
    position: absolute;
    bottom: calc(100% + 8px); /* sit above the swatch */
    left: 50%;
    transform: translateX(-50%) scale(0.85);
    transform-origin: bottom center;

    background-color: #111;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    white-space: nowrap;
    padding: 5px 10px;
    border-radius: 4px;
    pointer-events: none;

    opacity: 0;
    transition: opacity 0.15s ease, transform 0.15s ease;
    z-index: 100;
  }

  /* Arrow / caret pointing downward */
  .variant-input .swatch-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: #111;
  }

  /* Show on hover */
  .variant-input:hover .swatch-tooltip {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }
</style>

<div class="variant-wrapper js" data-type="button">
  <label class="variant__label{% if option.name == 'Default' or option.name == 'Title' %} hidden-label{% endif %}{% unless variant_labels %} hidden-label{% endunless %}">
    <span style="font-weight:bold;">{{ option.name }}</span> : <span id="selected-value-{{ forloop.index0 }}">{{ option.selected_value }}</span>
    {%- if connect_to_sizechart and is_size -%}
      <span class="variant__label-info">
        &mdash;
        {%- render
          'tool-tip-trigger',
          title: size_chart_title,
          content: section.blocks[sizechart_index].settings.size_chart.content,
          context: 'size-chart'
        -%}
      </span>
    {%- endif -%}
    {%- if is_color -%}
      <span class="variant__label-info">
        &mdash;
        <span
          data-variant-color-label
          data-index="{{ forloop.index0 }}"
          data-option-index="{{ color_option_index }}">
          {{ option.selected_value }}
        </span>
      </span>
    {%- endif -%}
  </label>

  {% assign optionName = option.name | downcase %}
  {%- assign option_index = forloop.index -%}

  <fieldset class="variant-input-wrap {% if optionName == 'color' or optionName == 'colore' or optionName == 'couleur' or optionName == 'colour' or optionName == 'coloure' or optionName == 'colori' or optionName == 'kleur' or optionName == 'farve' or optionName == 'farbe' %}hasimageSwatch{% endif %}"
    name="{{ option.name }}"
    data-index="option{{ option_index }}"
    data-handle="{{ option.name | handleize }}"
    id="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}">
    <legend class="hide">{{ option.name }}</legend>

    {%- for value in option.values -%}
      {%- liquid
        assign product_available = true
        if product.options.size == 1 and block.settings.product_dynamic_variants_enable
          assign product_available = product.variants[forloop.index0].available
        endif
      -%}
      <div
        class="variant-input"
        data-index="option{{ option_index }}"
        data-value="{{ value | escape }}">

        {%- comment %} ── Hover tooltip ── {% endcomment %}
        <span class="swatch-tooltip" aria-hidden="true">{{ value | escape }}</span>

        <input type="radio"
          form="{{ form_id }}"
          {% if option.selected_value == value %} checked="checked"{% endif %}
          value="{{ value | escape }}"
          data-index="option{{ option_index }}"
          name="{{ option.name }}"
          data-variant-input
          class="{% unless product_available %} disabled{% endunless %}{% if is_color %} variant__input--color-swatch{% endif %}"
          {% if is_color %} data-color-name="{{ value | escape }}"{% endif %}
          {% if is_color %} data-color-index="{{ color_option_index }}"{% endif %}
          id="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}">

        {%- if is_color -%}
          {%- if value.swatch -%}
            {%- liquid
              assign color_image = value.swatch.image | image_url: width: 50
              assign color_swatch_fallback = value.swatch.color
            -%}
            <label
              for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
              class="variant__button-label color-swatch color-swatch--{{ value | handle }}{% unless product_available %} disabled{% endunless %}"
              style="background-color: {{ color_swatch_fallback }};{% if value.swatch.image %}  background-image: url({{ color_image }});{% endif %}"
            >
              {{ value | escape }}
            </label>
          {%- else -%}
            {%- liquid
              assign color_file_name = value | handle | append: '.' | append: swatch_file_extension
              assign color_image = color_file_name | file_img_url: '50x50' | prepend: 'https:' | split: '?' | first
              assign color_swatch_fallback = value | split: ' ' | last | handle
            -%}
            <label
              for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
              class="variant__button-label color-swatch color-swatch--{{ value | handle }}{% unless product_available %} disabled{% endunless %}"
              style="background-color: {{ color_swatch_fallback }};{% if images[color_file_name] != blank %}  background-image: url({{ color_image }});{% endif %}"
            >
              {{ value | escape }}
            </label>
          {%- endif -%}
        {%- else -%}
          {% if optionName == 'color'
            or optionName == 'couleur'
            or optionName == 'colore'
            or optionName == 'coloure'
            or optionName == 'colour'
            or optionName == 'colori'
            or optionName == 'kleur'
            or optionName == 'farve'
            or optionName == 'farbe'
          %}
            {% assign hasImage = false %}
            {% assign selected_variant = product.selected_variant %}
            {% for variant in product.variants %}
              {% if variant.title contains value and variant.image %}
                {% assign selected_variant = variant -%}
                {%- assign hasImage = true %}
              {% endif %}
            {% endfor %}
            <label
              for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
              class="{% if hasImage %}mimgSwatch{% endif %} variant__button-label color-swatch--{{ value | handle }}{% unless product_available %} disabled{% endunless %}"
            >
              {% if hasImage %}
                <img
                  src="{{ selected_variant.image.src | image_url }}"
                  width="100px"
                  height="auto"
                  loading="lazy"
                  alt="{{ selected_variant.title }}"
                >
                <span class="visually-hidden"> {{ value -}}</span>
              {% else %}
                {{ value -}}
              {% endif %}
              <span class="visually-hidden">{{ 'products.product.variant_sold_out_or_unavailable' | t }}</span>
            </label>
          {% else %}
            <label
              for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
              {% unless product_available %}
                class="disabled"
              {% endunless %}
              class="u-other-varaitns"
            >
              {{- value | escape -}}
            </label>
          {% endif %}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </fieldset>
</div>
