<div>
  <svg
    role="presentation"
    fill="none"
    focusable="false"
    width="15"
    height="15"
    class="rating__star rating__star--full icon icon-rating-star"
    viewBox="0 0 15 15"
  >
    <path d="M7.5 0L9.58587 5.2731L15 5.72949L10.875 9.44483L12.1353 15L7.5 12.0231L2.86475 15L4.125 9.44483L0 5.72949L5.41414 5.2731L7.5 0Z"
      fill="{{ section.settings.iconcolor }}"
      ></path>
  </svg>
  <svg
    role="presentation"
    fill="none"
    focusable="false"
    width="15"
    height="15"
    class="rating__star rating__star--full icon icon-rating-star"
    viewBox="0 0 15 15"
  >
    <path d="M7.5 0L9.58587 5.2731L15 5.72949L10.875 9.44483L12.1353 15L7.5 12.0231L2.86475 15L4.125 9.44483L0 5.72949L5.41414 5.2731L7.5 0Z"
      fill="{% if block.settings.enablestars == 'one' %}
            {{ section.settings.disablediconcolor }}
        {% else %}
          {{ section.settings.iconcolor }}
        {% endif %}"
      ></path>
  </svg>
  <svg
    role="presentation"
    fill="none"
    focusable="false"
    width="15"
    height="15"
    class="rating__star rating__star--full icon icon-rating-star"
    viewBox="0 0 15 15"
  >
    <path d="M7.5 0L9.58587 5.2731L15 5.72949L10.875 9.44483L12.1353 15L7.5 12.0231L2.86475 15L4.125 9.44483L0 5.72949L5.41414 5.2731L7.5 0Z"
      fill="{% if block.settings.enablestars == 'two' or block.settings.enablestars == 'one' %}
          {{ section.settings.disablediconcolor }}
      {% else %}
        {{ section.settings.iconcolor }}
      {% endif %}"
      ></path>
  </svg>
  <svg
    role="presentation"
    fill="none"
    focusable="false"
    width="15"
    height="15"
    class="rating__star rating__star--full icon icon-rating-star"
    viewBox="0 0 15 15"
  >
    <path d="M7.5 0L9.58587 5.2731L15 5.72949L10.875 9.44483L12.1353 15L7.5 12.0231L2.86475 15L4.125 9.44483L0 5.72949L5.41414 5.2731L7.5 0Z"
      fill="{% if block.settings.enablestars == 'three' or block.settings.enablestars == 'two' or block.settings.enablestars == 'one' %}
          {{ section.settings.disablediconcolor }}
        {% else %}
          {{ section.settings.iconcolor }}
        {% endif %}
    "></path>
  </svg>
  <svg
    role="presentation"
    fill="none"
    focusable="false"
    width="15"
    height="15"
    class="rating__star rating__star--full icon icon-rating-star"
    viewBox="0 0 15 15"
  >
    <path d="M7.5 0L9.58587 5.2731L15 5.72949L10.875 9.44483L12.1353 15L7.5 12.0231L2.86475 15L4.125 9.44483L0 5.72949L5.41414 5.2731L7.5 0Z"
      fill="{% if block.settings.enablestars == 'four' or block.settings.enablestars == 'three' or block.settings.enablestars == 'two' or block.settings.enablestars == 'one' %}
             {{ section.settings.disablediconcolor }}
            {% else %}
              {{ section.settings.iconcolor }}
            {% endif %}
        "
      ></path>
  </svg>
</div>
