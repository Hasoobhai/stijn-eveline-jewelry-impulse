{% assign force_open = true %}

{%- if linklists[block.settings.menu].links.size > 0 -%}
  {%- if block.settings.show_footer_title -%}
    <h2 class="h4 footer__title small--hide">
      {{ linklists[block.settings.menu].title }}
    </h2>
    <h2 type="button" class="h4 footer__title collapsible-trigger collapsible-trigger-btn medium-up--hide {% if force_open %} is-open{% endif %}" aria-controls="Footer-{{ block.id }}" {% if force_open %}aria-expanded="true"{% endif %}>
      {{ linklists[block.settings.menu].title }}
      {%- render 'u-collapsible-icon' -%}
    </h2>
  {%- endif -%}
  <div
    {% if block.settings.show_footer_title %}
      id="Footer-{{ block.id }}" class="collapsible-content collapsible-content--small {% if force_open %} is-open{% endif %}" {% if force_open %}style="height:100%;"{% endif %}
    {% endif %}
  >
    <div class="collapsible-content__inner">
      <div class="footer__collapsible{% unless block.settings.show_footer_title %} footer_collapsible--disabled{% endunless %}">
        <ul class="no-bullets site-footer__linklist">
          {%- for link in linklists[block.settings.menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
{%- endif -%}
