    "haseeb_faq_cfWKBh": {
      "type": "haseeb-faq",
      "blocks": {
        "faq_TM8KXN": {
          "type": "faq",
          "settings": {
            "question": "What if I would like to return my order?",
            "answer": "<p>We want you to love your Eveline Jewelry piece just as much as we loved making it. If it is not quite right, you are welcome to request a return or exchange within 30 days of receiving your order.</p><p>All we ask is that the piece comes back to us in acceptable condition and in its original packaging. Email info@evelinejewelry.com with your order details, and we will take care of the rest.</p>",
            "open_by_default": false
          }
        },
        "faq_Jrp6it": {
          "type": "faq",
          "settings": {
            "question": "Will my jewelry fade or tarnish?",
            "answer": "<p>Your jewelry is made to last. Our materials are chosen for durability and everyday wear, and the finish is designed to hold up over time. Like anything well made, it will develop character with use, but it should not discolor under normal conditions. With a little care, it will stay beautiful for years.</p>",
            "open_by_default": false
          }
        },
        "faq_7C8wrE": {
          "type": "faq",
          "settings": {
            "question": "Is shipping really free?",
            "answer": "<p>Yes. For all orders within the Europe. There is no paid priority option because it is not needed — every customer receives the same fast, careful service.</p><p>We pack each Eveline Jewelry piece by hand and ship it as soon as your order comes in. Once your package is on its way, you will receive a tracking number by email.</p><p>Delivery times vary slightly depending on where you live, but our promise is simple: we ship quickly, and you never pay for shipping.</p>",
            "open_by_default": false
          }
        },
        "faq_XbPQY4": {
          "type": "faq",
          "settings": {
            "question": "Are all your products handmade?",
            "answer": "<p>Every design is created by Eveline Jewelry. Each piece begins as a sketch at our workbench, is brought to life by hand in our studio, and is inspected by one of us before it is sent to you.</p>",
            "open_by_default": false
          }
        },
        "faq_LzzX9T": {
          "type": "faq",
          "settings": {
            "question": "What if my piece breaks or needs repair?",
            "answer": "<p>Life happens. If your piece needs attention, email info@evelinejewelry.com with your order number and a clear photo of the issue. Within the first 6 months, we will repair or replace pieces that show a problem with materials or craftsmanship whenever possible.</p><p>For accidents or well loved wear after that, we are still happy to review repair options or offer a discount toward a replacement.</p>",
            "open_by_default": false
          }
        },
        "feature_g6Cjk6": {
          "type": "feature",
          "settings": {
            "icon": "shield",
            "title": "Lifetime Warranty",
            "text": "<p>On every piece we make.</p>"
