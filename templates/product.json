    "haseeb_testimonial_XTMjaN": {
      "type": "haseeb-testimonial",
      "blocks": {
        "testimonial_QLyPwP": {
          "type": "testimonial",
          "settings": {
            "video_url": "",
            "stars": 5,
            "text": "<p>\"I was skeptical for years. My daughter finally convinced me to try it. I've worn it every day since — it goes on before anything else in the morning.\"</p>",
            "author": "Sandra M.",
            "verified": true,
            "verified_label": "Verified buyer"
          }
        },
        "testimonial_xePdVB": {
          "type": "testimonial",
          "settings": {
            "video_url": "",
            "stars": 5,
            "text": "<p>\"Bought one piece from Eveline Jewelry, came back for two more. The finish still looks like the day it arrived.\"</p>",
            "author": "Carol B.",
            "verified": true,
            "verified_label": "Verified buyer"
          }
        },
        "testimonial_ThHarE": {
          "type": "testimonial",
          "settings": {
            "video_url": "",
            "stars": 5,
            "text": "<p>\"I expected to wear these occasionally. They're now the first thing I put on in the morning and the last thing I take off.\"</p>",
            "author": "Diane R.",
            "verified": true,
            "verified_label": "Verified buyer"
          }
        },
        "testimonial_FpPzD6": {
          "type": "testimonial",
          "settings": {
            "video_url": "",
            "stars": 5,
            "text": "<p>\"You can feel immediately this is solid metal — the weight, the texture, the way it sits on the wrist. I've had plated pieces before. This is completely different.\"</p>",
            "author": "Margaret T.",
            "verified": true,
            "verified_label": "Verified buyer"
          }
        },
        "testimonial_jAQgUq": {
          "type": "testimonial",
          "settings": {
            "video_url": "",
            "stars": 5,
            "text": "<p>\"Worn every day for two months — through the shower, through work, through everything. Still looks exactly like day one.\"</p>",
            "author": "Patricia K.",
            "verified": true,
            "verified_label": "Verified buyer"
          }
        }
      },
