    margin:10px 0;
  }
}

.u-btn{
  font-size:13px;
  font-weight:bold;
  position:relative;
  border: none;
  text-transform:uppercase;
  letter-spacing:0;
  padding: 0;
  min-width: fit-content;
  height:35px;
}
.u-btn:after{
  content: "";
  width: 100%;
  height: 1px;
  background: currentColor;
  position: absolute;
  inset-inline-start: 0;
  bottom: 0;
  transform: scaleX(1);
  transform-origin: right;
}
.u-btn:hover:after{
  transform: scaleX(1);
  transform-origin: left;
  animation: text-underlined .6s;
}
@media(max-width:769px){
  .u-btn{
    height:25px;
  }
}




.u-color-btn {
    position: relative;
    background-color: {{settings.buttonclr}};
    color: #fff;
    padding: 5px 15px;
    overflow: hidden;
    z-index: 1;
    display: inline-block;
}
.u-color-btn:hover{
    color:#fff;
}

.u-color-btn:before {
    content: "";
    position: absolute;
    inset: 0;
    background: {{settings.buttonclr2}};
    transform: translateX(-100%);
    transition: transform .3s cubic-bezier(.75, 0, .125, 1);
    z-index: -2;
    left:-10px;
}

.u-color-btn:after {
    content: "";
    position: absolute;
    inset: 0;
    background: #3B442C;
    transform: translateX(-100%);
    transition: transform .3s cubic-bezier(.75, 0, .125, 1);
    transition-delay: .17s;
    z-index: -1;
}

.u-color-btn:hover:before {
    transform: translateX(0);
}

.u-color-btn:hover:after {
    transform: translateX(0);
}
.u-color-btn-primary{
    background-color: {{settings.buttonclr}};
    display: block;
    width: fit-content;
    margin: 0 auto;
    text-transform:uppercase;
    padding:15px 40px;
    font-size:13px;
    font-weight:bold;
    margin-top:20px;
}


@keyframes text-underlined{
    0% {
        transform: scaleX(1);
        transform-origin: right;
    }
    50% {
        transform: scaleX(0);
        transform-origin: right;
    }
    51% {
        transform-origin: left;
    }
    100% {
        transform: scaleX(1);
    }
}

