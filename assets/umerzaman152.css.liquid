/* Sticky ATC */

.matcBar{
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 10px 50px;
  background: #fff;
  border-top: 1px solid #e8e8e8;
  z-index: 99999;
  transform: translateY(100%);
  transition: .4s all ease;
  -webkit-transition: .4s all ease; 
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.1);
}
.matcBar.mvisible{
  transform: translateY(0);
}
.matc-wrapper{
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  gap: 10px;
}
.matc-productinfo{
  display: flex;
  align-items: center;
  gap: 15px;
  width: 100%;
  overflow: hidden;
}
.matc-img{
  width: 90px;
  min-width: 50px;
  height: 90px;
  position:relative;
  overflow:hidden;
  flex-shrink:0;
}
.matc-img img{
  position:absolute;
  inset:0;
  object-fit:cover;
  vertical-align:middle;
}
.matc-titlePrice h5{
  margin-bottom: 0;
  white-space: nowrap;
  font-size:13px;
  letter-spacing: 0;
}
.matc-price{
  color: var(--colorSalePrice);
  font-size: larger;
  font-weight: bold;
}
.matc-compare-price{
  text-decoration: line-through;
}
.matc-form {
  display: flex;
  align-items: center;
  gap: 10px;
  width: fit-content;
}
.matc-quantityvariant .js-qty__wrapper{
  min-width: 120px;
}
.matc-quantityvariant .js-qty__wrapper .js-qty__num{
  min-height: 48px;
}
.matc-quantityvariant{
  display: flex;
  gap: 10px;
  align-items: center;
  flex-direction:row-reverse;
}
.matc-form .variant-wrapper+.variant-wrapper{
  margin-top: 0;
}
.matc-btn{
  text-wrap: nowrap;
  text-transform:uppercase;
  font-size:13px;
  border-radius: 0;
  letter-spacing: 0;
}
.matc-variantsSelecter{
  min-height:48px;
  font-size: 13px!important;
}
.matc-quantityvariant .product__quantity{
  display:block;
}
@media (max-width: 767px){
  .matcBar{
    padding:10px 15px;
  }
  .matc-productinfo{
    display: none;
  }
  .matc-quantityvariant{
    width: 60%;
  }
.matc-quantityvariant .product__quantity{
  display:none;
}  
  .matc-quantityvariant .js-qty__wrapper{
    min-width: 100%;
    max-width: 100%;
  }
  .matc-variantsSelecter{
    width: 100%;
  }
  .matc-form{
    flex-wrap: nowrap;
    width:100%;
  }
  .matcBar .btn--full{
    padding:14px 20px;
  }
  .matc-btn{
    letter-spacing:0;
  }
}
/* Sticky Atc end */

.product__photos .flickity-page-dots{
  display:none;
}
.product__thumbs--below .product__thumb-item{
  height:80px;
}
.product__thumbs .image-wrap__thumbnail{
  padding-bottom: 100%!important
}