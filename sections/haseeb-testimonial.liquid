{%- liquid
  assign uid = section.id
  assign root = 'ts-' | append: uid
  assign heading_tag = section.settings.heading_tag
-%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"></noscript>

<style>
  #{{ root }} {
    --ts-card-bg: {{ section.settings.card_bg }};
    --ts-card-border: {{ section.settings.card_border }};
    --ts-card-radius: {{ section.settings.card_radius }}px;
    --ts-media-radius: {{ section.settings.media_radius }}px;
    --ts-heading-color: {{ section.settings.heading_color }};
    --ts-subheading-color: {{ section.settings.subheading_color }};
    --ts-text-color: {{ section.settings.text_color }};
    --ts-author-color: {{ section.settings.author_color }};
    --ts-star-color: {{ section.settings.star_color }};
    --ts-control-color: {{ section.settings.control_color }};
    --ts-ratio: {{ section.settings.media_ratio_mobile }};
    background-color: {{ section.settings.bg_color }};
    {% if section.settings.border_width > 0 %}
      border-top: solid {{ section.settings.border_color }} {{ section.settings.border_width }}px;
      border-bottom: solid {{ section.settings.border_color }} {{ section.settings.border_width }}px;
    {% endif %}
    margin-top: {{ section.settings.margin_top | times: 0.75 | round }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round }}px;
  }

  #{{ root }} .ts-inner {
    margin: 0 auto;
    max-width: {{ section.settings.content_width }}px;
    padding: {{ section.settings.padding_top | times: 0.75 | round }}px 1.5rem {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  #{{ root }} .ts-heading,
  #{{ root }} .ts-subheading {
    text-align: {{ section.settings.heading_alignment }};
  }

  #{{ root }} .ts-heading * ,
  #{{ root }} .ts-heading {
    margin: 0;
    font-size: {{ section.settings.heading_size | times: 0.73 | round }}px;
    color: var(--ts-heading-color);
    line-height: 130%;
    text-transform: unset;
  }

  #{{ root }} .ts-subheading {
    margin-top: 9px;
  }

  #{{ root }} .ts-subheading * {
    margin: 0;
    font-size: {{ section.settings.subheading_size | times: 0.75 | round }}px;
    color: var(--ts-subheading-color);
    line-height: 150%;
    text-transform: unset;
  }

  #{{ root }} .ts-slider {
    margin: 15px -1.5rem 0 !important;
    padding: 0 1.5rem !important;
  }

  #{{ root }} .ts-slider .swiper-wrapper {
    align-items: stretch !important;
  }

  #{{ root }} .ts-slide {
    display: flex !important;
    flex-direction: column;
    justify-content: flex-start;
    gap: 9px;
    padding: 16px;
    border-radius: var(--ts-card-radius);
    {% if section.settings.card_border_width > 0 %}
      border: {{ section.settings.card_border_width }}px solid var(--ts-card-border);
    {% endif %}
    background-color: var(--ts-card-bg);
    box-sizing: border-box !important;
    height: auto !important;
    overflow: hidden;
  }

  #{{ root }} .ts-content {
    flex: 1 1 auto;
    display: flex !important;
    flex-direction: column;
    gap: 9px;
  }

  #{{ root }} .ts-media {
    border-radius: var(--ts-media-radius);
    overflow: hidden;
    position: relative;
    aspect-ratio: var(--ts-ratio);
    background-color: #dadada;
  }

  #{{ root }} .ts-media img,
  #{{ root }} .ts-media svg,
  #{{ root }} .ts-media video,
  #{{ root }} .ts-media iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    box-shadow: none;
    object-fit: cover;
  }

  #{{ root }} .ts-stars {
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.text_alignment }};
    gap: 1px;
  }

  #{{ root }} .ts-stars svg {
    display: block;
    width: {{ section.settings.star_size }}px;
    height: {{ section.settings.star_size }}px;
  }

  #{{ root }} .ts-stars svg path {
    fill: var(--ts-star-color);
  }

  #{{ root }} .ts-text {
    text-align: {{ section.settings.text_alignment }};
  }

  #{{ root }} .ts-text * {
    margin: 0;
    font-size: {{ section.settings.body_size }}px;
    color: var(--ts-text-color);
    line-height: 140%;
    text-transform: unset;
  }

  #{{ root }} .ts-author {
    text-align: {{ section.settings.text_alignment }};
    margin-top: auto;
  }

  #{{ root }} .ts-author * {
    margin: 0;
    font-size: {{ section.settings.author_size }}px;
    color: var(--ts-author-color);
    line-height: 130%;
    text-transform: unset;
  }

  #{{ root }} .ts-verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
    font-size: {{ section.settings.author_size | minus: 2 }}px;
    color: var(--ts-author-color);
    opacity: 0.8;
  }

  #{{ root }} .ts-verified svg {
    width: 12px;
    height: 12px;
    flex: 0 0 12px;
  }

  #{{ root }} .ts-nav {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 30px;
    justify-content: center;
  }

  #{{ root }} .ts-prev,
  #{{ root }} .ts-next {
    position: static !important;
    flex: 0 0 {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size | divided_by: 2 }}px;
    background: transparent;
    transition: opacity 0.3s ease;
    cursor: pointer;
    -webkit-appearance: none;
    border: 0;
    box-shadow: none;
    padding: 0;
    display: none;
  }

  #{{ root }} .ts-prev svg,
  #{{ root }} .ts-next svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #{{ root }} .ts-prev svg path,
  #{{ root }} .ts-next svg path {
    fill: var(--ts-control-color);
  }

  #{{ root }} .ts-prev:focus-visible,
  #{{ root }} .ts-next:focus-visible {
    outline: 2px solid var(--ts-control-color);
    outline-offset: 4px;
  }

  #{{ root }} .ts-prev.swiper-button-disabled,
  #{{ root }} .ts-next.swiper-button-disabled {
    opacity: 0.3;
  }

  #{{ root }} .ts-pagination {
    position: static !important;
    width: 100%;
    max-width: fit-content;
    display: flex;
    gap: 5px;
    justify-content: center;
    align-items: center;
  }

  #{{ root }} .ts-pagination .swiper-pagination-bullet {
    flex: 0 0 10px;
    width: 10px;
    height: 10px;
    background-color: transparent !important;
    transition: background-color 0.25s ease;
    border: 1px solid var(--ts-control-color) !important;
    opacity: 1 !important;
  }

  #{{ root }} .ts-pagination .swiper-pagination-bullet-active {
    background-color: var(--ts-control-color) !important;
  }

  {%- if section.settings.show_pagination_mobile -%}
    #{{ root }} .ts-pagination { display: flex !important; }
  {%- else -%}
    #{{ root }} .ts-pagination { display: none !important; }
  {%- endif -%}

  /* Static fallback before Swiper boots */
  #{{ root }} .ts-slider:not(.swiper-initialized) .swiper-wrapper {
    display: flex;
    gap: {{ section.settings.gap_mobile }}px;
    overflow: hidden;
  }

  #{{ root }} .ts-slider:not(.swiper-initialized) .ts-slide {
    flex: 0 0 calc(100% / {{ section.settings.slides_mobile }});
  }

  @media (min-width: 1024px) {
    #{{ root }} {
      --ts-ratio: {{ section.settings.media_ratio_desktop }};
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }

    #{{ root }} .ts-inner {
      padding: {{ section.settings.padding_top }}px 5rem {{ section.settings.padding_bottom }}px;
    }

    #{{ root }} .ts-heading *,
    #{{ root }} .ts-heading {
      font-size: {{ section.settings.heading_size }}px;
    }

    #{{ root }} .ts-subheading {
      margin-top: 12px;
    }

    #{{ root }} .ts-subheading * {
      font-size: {{ section.settings.subheading_size }}px;
    }

    #{{ root }} .ts-slider {
      margin: 20px -5rem 0 !important;
      padding: 0 5rem !important;
    }

    #{{ root }} .ts-slide {
      padding: 20px;
      gap: 12px;
    }

    #{{ root }} .ts-content {
      gap: 12px;
    }

    #{{ root }} .ts-nav {
      margin-top: 40px;
      gap: 20px;
    }

    {%- if section.settings.show_arrows_desktop -%}
      #{{ root }} .ts-prev,
      #{{ root }} .ts-next { display: flex; }
    {%- endif -%}

    {%- if section.settings.show_pagination_desktop -%}
      #{{ root }} .ts-pagination { display: flex !important; }
    {%- else -%}
      #{{ root }} .ts-pagination { display: none !important; }
    {%- endif -%}

    #{{ root }} .ts-slider:not(.swiper-initialized) .swiper-wrapper {
      gap: {{ section.settings.gap_desktop }}px;
    }

    #{{ root }} .ts-slider:not(.swiper-initialized) .ts-slide {
      flex: 0 0 calc(100% / {{ section.settings.slides_desktop }});
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ root }} .ts-slider .swiper-wrapper {
      transition-duration: 0ms !important;
    }
  }
</style>

<div id="{{ root }}" class="ts-section">
  <div class="ts-inner">
    {%- if section.settings.heading != blank -%}
      <div class="ts-heading">
        <{{ heading_tag }}>{{ section.settings.heading }}</{{ heading_tag }}>
      </div>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="ts-subheading">{{ section.settings.subheading }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="ts-slider swiper"
        data-ts-slider
        data-gap="{{ section.settings.gap_desktop }}"
        data-gap-mobile="{{ section.settings.gap_mobile }}"
        data-view="{{ section.settings.slides_desktop }}"
        data-view-tablet="{{ section.settings.slides_tablet }}"
        data-view-mobile="{{ section.settings.slides_mobile }}"
        data-autoplay="{{ section.settings.autoplay_seconds }}"
        data-loop="{{ section.settings.loop }}"
        data-centered="{{ section.settings.centered }}"
      >
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            <div class="ts-slide swiper-slide" {{ block.shopify_attributes }}>
              {%- if block.settings.video != blank -%}
                <div class="ts-media">
                  {{ block.settings.video | video_tag: image_size: '800x', controls: true, playsinline: true, preload: 'metadata' }}
                </div>
              {%- elsif block.settings.video_url != blank -%}
                <div class="ts-media">
                  {%- if block.settings.video_url.type == 'youtube' -%}
                    <iframe
                      src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?rel=0"
                      title="{{ block.settings.author | escape }} testimonial"
                      loading="lazy"
                      allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    ></iframe>
                  {%- else -%}
                    <iframe
                      src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}"
                      title="{{ block.settings.author | escape }} testimonial"
                      loading="lazy"
                      allow="autoplay; fullscreen; picture-in-picture"
                      allowfullscreen
                    ></iframe>
                  {%- endif -%}
                </div>
              {%- elsif block.settings.image != blank -%}
                <div class="ts-media">
                  {{
                    block.settings.image
                    | image_url: width: 1000
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 750, 1000',
                      sizes: '(min-width: 1024px) 25vw, 80vw',
                      alt: block.settings.image.alt | default: block.settings.author
                  }}
                </div>
              {%- elsif section.settings.show_placeholder -%}
                <div class="ts-media">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {%- endif -%}

              <div class="ts-content">
                {%- if block.settings.stars > 0 -%}
                  <div class="ts-stars" role="img" aria-label="{{ block.settings.stars }} out of 5 stars">
                    {%- for i in (1..block.settings.stars) -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="19" viewBox="0 0 20 19" fill="none" aria-hidden="true" focusable="false">
                        <path d="M10 0L12.9389 5.95492L19.5106 6.90983L14.7553 11.5451L15.8779 18.0902L10 15L4.12215 18.0902L5.24472 11.5451L0.489435 6.90983L7.06107 5.95492L10 0Z"/>
                      </svg>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="ts-text">{{ block.settings.text }}</div>
                {%- endif -%}

                {%- if block.settings.author != blank -%}
                  <div class="ts-author">
                    <p><strong>{{ block.settings.author | escape }}</strong></p>
                    {%- if block.settings.verified -%}
                      <span class="ts-verified">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <circle cx="12" cy="12" r="10"/>
                          <path d="m8 12 3 3 5-6"/>
                        </svg>
                        {{ block.settings.verified_label | escape }}
                      </span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="ts-nav">
          <button class="ts-prev" type="button" aria-label="Previous testimonial">
            <svg width="92" height="38" viewBox="0 0 92 38" fill="none" xmlns="http://www.w3.org/2000/svg" style="transform: rotate(180deg);" aria-hidden="true">
              <path d="M72.472 0L71.063 1.409L87.303 17.649H0V19.643H87.3L71.06 35.883L72.469 37.293L91.115 18.646L72.472 0Z"/>
            </svg>
          </button>
          <div class="ts-pagination swiper-pagination"></div>
          <button class="ts-next" type="button" aria-label="Next testimonial">
            <svg width="92" height="38" viewBox="0 0 92 38" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M72.472 0L71.063 1.409L87.303 17.649H0V19.643H87.3L71.06 35.883L72.469 37.293L91.115 18.646L72.472 0Z"/>
            </svg>
          </button>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var SECTION_ID = {{ section.id | json }};

    window.__tsSwiperReady = window.__tsSwiperReady || new Promise(function (resolve) {
      if (window.Swiper) return resolve();
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
      s.onload = resolve;
      s.onerror = resolve;
      document.head.appendChild(s);
    });

    function init(sectionId) {
      var root = document.getElementById('ts-' + sectionId);
      if (!root) return;
      var el = root.querySelector('[data-ts-slider]');
      if (!el || !window.Swiper) return;

      if (el.swiperInstance) {
        el.swiperInstance.destroy(true, true);
        el.swiperInstance = null;
      }

      var d = el.dataset;
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var autoplaySeconds = parseFloat(d.autoplay || 0);
      var slideCount = el.querySelectorAll('.swiper-slide').length;
      var maxView = Math.max(parseFloat(d.view) || 1, parseFloat(d.viewMobile) || 1);
      var canLoop = d.loop === 'true' && slideCount > Math.ceil(maxView) + 1;

      el.swiperInstance = new window.Swiper(el, {
        speed: reduceMotion ? 0 : 300,
        spaceBetween: parseInt(d.gapMobile || 0, 10),
        loop: canLoop,
        centeredSlides: d.centered === 'true',
        watchOverflow: true,
        a11y: { enabled: true },
        autoplay: autoplaySeconds > 0 && !reduceMotion
          ? { delay: autoplaySeconds * 1000, pauseOnMouseEnter: true, disableOnInteraction: false }
          : false,
        navigation: {
          nextEl: root.querySelector('.ts-next'),
          prevEl: root.querySelector('.ts-prev')
        },
        pagination: {
          el: root.querySelector('.ts-pagination'),
          type: 'bullets',
          clickable: true
        },
        breakpoints: {
          320: {
            spaceBetween: parseInt(d.gapMobile || 0, 10),
            slidesPerView: parseFloat(d.viewMobile) || 1.2
          },
          768: {
            spaceBetween: parseInt(d.gap || 0, 10),
            slidesPerView: parseFloat(d.viewTablet) || 2
          },
          1024: {
            spaceBetween: parseInt(d.gap || 0, 10),
            slidesPerView: parseFloat(d.view) || 3.5
          }
        }
      });

      // Pause any playing media when the slide changes
      el.swiperInstance.on('slideChange', function () {
        el.querySelectorAll('video').forEach(function (video) { video.pause(); });
        el.querySelectorAll('iframe').forEach(function (frame) {
          frame.src = frame.src.replace(/[?&]autoplay=1/g, '');
        });
      });
    }

    function boot() {
      window.__tsSwiperReady.then(function () { init(SECTION_ID); });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }

    if (window.Shopify && window.Shopify.designMode) {
      document.addEventListener('shopify:section:load', function (e) {
        if (e.detail.sectionId === SECTION_ID) boot();
      });
      document.addEventListener('shopify:section:unload', function (e) {
        if (e.detail.sectionId !== SECTION_ID) return;
        var root = document.getElementById('ts-' + SECTION_ID);
        var el = root && root.querySelector('[data-ts-slider]');
        if (el && el.swiperInstance) {
          el.swiperInstance.destroy(true, true);
          el.swiperInstance = null;
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Testimonial slider",
  "tag": "section",
  "class": "section section-testimonial-slider",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<strong>10,000+ Customers Have Made Eveline Jewelry Part of Their Daily Life</strong>"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "info": "Use h2 unless this section sits under another heading.",
      "options": [
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 18,
      "max": 56,
      "step": 1,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 30
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Subheading size (desktop)",
      "default": 18
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "min": 1,
      "max": 5,
      "step": 0.1,
      "label": "Slides per view (desktop)",
      "info": "Use a decimal like 3.5 to peek the next card.",
      "default": 3.5
    },
    {
      "type": "range",
      "id": "slides_tablet",
      "min": 1,
      "max": 4,
      "step": 0.1,
      "label": "Slides per view (tablet)",
      "default": 2.2
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "label": "Slides per view (mobile)",
      "default": 1.3
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Gap (desktop)",
      "default": 28
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap (mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Autoplay delay",
      "info": "Set to 0 to turn autoplay off.",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "centered",
      "label": "Center active slide",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows_desktop",
      "label": "Show arrows on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination_mobile",
      "label": "Show dots on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination_desktop",
      "label": "Show dots on desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "arrow_size",
      "min": 30,
      "max": 90,
      "step": 2,
      "unit": "px",
      "label": "Arrow width",
      "default": 50
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "select",
      "id": "media_ratio_desktop",
      "label": "Image ratio (desktop)",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/5", "label": "Portrait 4:5" },
        { "value": "3/4", "label": "Portrait 3:4" },
        { "value": "4/3", "label": "Landscape 4:3" },
        { "value": "16/9", "label": "Landscape 16:9" }
      ],
      "default": "1/1"
    },
    {
      "type": "select",
      "id": "media_ratio_mobile",
      "label": "Image ratio (mobile)",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/5", "label": "Portrait 4:5" },
        { "value": "3/4", "label": "Portrait 3:4" },
        { "value": "4/3", "label": "Landscape 4:3" },
        { "value": "16/9", "label": "Landscape 16:9" }
      ],
      "default": "1/1"
    },
    {
      "type": "range",
