{% style %}
  .u-collection-coded-by-umerzaman152.u-{{ section.id }}{
    padding-top: {{ section.settings.space_top }}px;
    padding-bottom: {{ section.settings.space_bottom }}px;
    background: {{ section.settings.section_bg }};
  }

  .u-{{ section.id }} .u-collections-heading{
    text-align: {{ section.settings.heading_align }};
    margin: 0 0 {{ section.settings.heading_bottom_space }}px;
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
  }

  .u-{{ section.id }} .u-collections-wrapper{
    gap: {{ section.settings.desktop_gap }}px;
  }

  .u-{{ section.id }} .u-collection-card-image{
    border-radius: {{ section.settings.image_radius }}px;
    aspect-ratio: {{ section.settings.image_ratio }};
  }

  .u-{{ section.id }} .u-collection-card-title{
    font-size: {{ section.settings.title_size }}px;
    color: {{ section.settings.title_color }};
    margin-bottom: {{ section.settings.title_bottom_space }}px;
  }

  .u-{{ section.id }} .u-collection-card-count{
    font-size: {{ section.settings.count_size }}px;
    color: {{ section.settings.count_color }};
  }

  .u-{{ section.id }} .u-collection-card-arrow{
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    background: {{ section.settings.arrow_bg }};
  }
  .u-{{ section.id }} .u-collection-card-arrow svg{
    fill:{{ section.settings.arrow_color }};
  }
  .u-{{ section.id }} .u-collection-card-content{
    padding-top: {{ section.settings.content_top_space }}px;
  }

  @media(max-width: 768px){
    .u-{{ section.id }} .u-collections-wrapper{
      gap: {{ section.settings.mobile_gap }}px;
    }

    .u-{{ section.id }} .u-collections-heading{
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    .u-{{ section.id }} .u-collection-card-title{
      font-size: {{ section.settings.title_size_mobile }}px;
    }

    .u-{{ section.id }} .u-collection-card-count{
      font-size: {{ section.settings.count_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="u-collection-coded-by-umerzaman152 u-{{ section.id }}">
  <div class="page-width">
    
    {% if section.settings.heading != blank %}
      <h2 class="u-collections-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="u-collections-wrapper">
      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}

        {% assign collection_image = block.settings.custom_image %}

        {% if collection_image == blank %}
          {% assign collection_image = collection.image %}
        {% endif %}

        {% if collection_image == blank and collection.products.first.featured_image != blank %}
          {% assign collection_image = collection.products.first.featured_image %}
        {% endif %}

        <a
          href="{{ collection.url }}"
          class="u-collection-card"
          {{ block.shopify_attributes }}
        >
          <div class="u-collection-card-image">
            {% if collection_image != blank %}
              {{
                collection_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400,600,800,1000,1200',
                  class: 'u-collection-card-img'
              }}
            {% endif %}
          </div>

          <div class="u-collection-card-content">
            <div class="u-collection-card-text">
              {% if block.settings.custom_title != blank %}
                <h3 class="u-collection-card-title">
                  {{ block.settings.custom_title }}
                </h3>
              {% else %}
                <h3 class="u-collection-card-title">
                  {{ collection.title }}
                </h3>
              {% endif %}

              <div class="u-collection-card-count">
                {{ 'collections.general.items_with_count' | t: count: collection.products_count }}
              </div>
            </div>

            <div class="u-collection-card-arrow u-color-btn">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M297.4 566.6C309.9 579.1 330.2 579.1 342.7 566.6L502.7 406.6C515.2 394.1 515.2 373.8 502.7 361.3C490.2 348.8 469.9 348.8 457.4 361.3L352 466.7L352 96C352 78.3 337.7 64 320 64C302.3 64 288 78.3 288 96L288 466.7L182.6 361.3C170.1 348.8 149.8 348.8 137.3 361.3C124.8 373.8 124.8 394.1 137.3 406.6L297.3 566.6z"/></svg>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

