{% style %}
  .u-marquee-container {
    animation: track {{ section.settings.textSpeed }}s linear forwards infinite;
  }
  .u-marquee-text p{
    color: {{ section.settings.textClr }};
    font-size: {{ section.settings.textSize }}px;
    margin: 0;
    padding: 0 {{ section.settings.textSpace }}px;
    white-space: nowrap;
  }
  @media(max-width:769px){
    .u-marquee-wrapper-{{ section.id }}{
      height: {{ section.settings.mptb }}px!important;
    }
  }
{% endstyle %}
{% if section.settings.enable == true %}
  <div
    class="u-marquee-wrapper u-marquee-wrapper-{{ section.id }}"
    id="u-marquee"
    style="height: {{ section.settings.ptb }}px; background: {{ section.settings.bgClr }}"
  >
    <div class="u-marquee-containerWrapper">
      {% for i in (1..10) %}
        <div class="u-marquee-container">
          <div class="u-marquee-content">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'text' %}
                  <div class="u-marquee-text">
                    <p>{{ block.settings.text }}</p>
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}
{% schema %}
{
  "name": "U Sliding Text",
  "settings": [
      {
        "type": "checkbox",
        "id": "enable",
        "label": "Enable Section",
        "default": false
      },
      {
        "type": "range",
        "id": "textSpeed",
        "min": 10,
        "max": 200,
        "step": 2,
        "unit": "sec",
        "label": "Animation Speed",
        "default": 10
      },
      {
        "type": "range",
        "id": "ptb",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Height",
        "default": 30
      },
      {
        "type": "range",
        "id": "mptb",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Mobile Height",
        "default": 30
      },
      {
        "type": "color",
        "id": "bgClr",
        "label": "Background Color",
        "default": "#000000"
      },
        {
        "type": "color",
        "id": "textClr",
        "label": "Text Color",
        "default": "#ffffff"
      },
      {
        "type": "range",
        "id": "textSize",
        "min": 10,
        "max": 60,
        "step": 1,
        "unit": "px",
        "label": "Text Size",
        "default": 16
      },
        {
        "type": "range",
        "id": "textSpace",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Text Space",
        "default": 50
      }
  ],
  "blocks": [
    {
    "type": "text",
    "name": "Text Box",
    "settings":[
      {
        "type": "inline_richtext",
        "id": "text",
        "label": "Add some text",
        "default": "Add your text here"
      }
    ]
  }
  ],
  "presets":[
    {
      "name":"U Sliding Text"
    }
  ]
}
{% endschema %}
