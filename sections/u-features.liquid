      "min": 0,
      "max": 60,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Inner Space Bottom",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_left",
