      "step": 1,
      "default": 36
    },
    {
      "type": "range",
      "id": "icon_box_height",
      "label": "Icon Box Height",
      "min": 20,
      "max": 80,
      "step": 1,
      "default": 36
    },
    {
      "type": "range",
      "id": "icon_width",
      "label": "Icon Width",
      "min": 10,
      "max": 50,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
