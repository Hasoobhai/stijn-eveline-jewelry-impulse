<style>
  .u-feature-strip-{{ section.id }}{
    padding-top: {{ section.settings.space_top }}px;
    padding-bottom: {{ section.settings.space_bottom }}px;
  }
  .u-feature-strip-{{ section.id }} .u-feature-strip__inner{
    gap: {{ section.settings.desktop_gap }}px;
  }
  .u-feature-strip-{{ section.id }} .u-feature-item{
    gap: {{ section.settings.item_gap }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_left }}px;
    padding-right: {{ section.settings.padding_right }}px;
    border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    border-radius: {{ section.settings.border_radius }}px;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .u-feature-strip-{{ section.id }} .u-feature-item:hover{
    background: {{ section.settings.hover_bg }};
    border-color: {{ section.settings.hover_border }};
    color: {{ section.settings.hover_text }};
  }
  .u-feature-strip-{{ section.id }} .u-feature-icon{
    width: {{ section.settings.icon_box_width }}px;
    height: {{ section.settings.icon_box_height }}px;
    background: {{ section.settings.icon_bg }};
    border-radius: {{ section.settings.icon_radius }}px;
  }
  .u-feature-strip-{{ section.id }} .u-feature-text{
    font-size: {{ section.settings.text_size_desktop }}px;
    line-height: 1.2;
  }
  @media (max-width: 768px){
    .u-feature-strip-{{ section.id }} .u-feature-item{
      width: {{ section.settings.mobile_card_width }}px;
    }

    .u-feature-strip-{{ section.id }} .u-feature-text{
      font-size: {{ section.settings.text_size_mobile }}px;
    }

    .u-feature-strip-{{ section.id }} .u-feature-strip__inner{
      gap: {{ section.settings.mobile_gap }}px;
    }
  }
</style>
<div class="u-feature-strip u-feature-strip-{{ section.id }}">
  <div class="u-feature-strip__inner page-width container">

    {% for block in section.blocks %}
      <div class="u-feature-item u-feature-item-{{ block.id }}" {{ block.shopify_attributes }}>

        {% if block.settings.icon != blank %}
          <div class="u-feature-icon">
            <img src="{{ block.settings.icon | image_url }}" alt="coded-by-umerzaman152" width="{{ section.settings.icon_width }}px;" height="auto">
          </div>
        {% endif %}
        {% if block.settings.text != blank %}
          <div class="u-feature-text">
            {{ block.settings.text }}
          </div>
        {% endif %}

      </div>
    {% endfor %}

  </div>
</div>
{% schema %}
{
