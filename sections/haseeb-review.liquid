{%- liquid
  assign uid = section.id | replace: '_', '' | replace: '-', ''
  assign bar = 'hl-bar-' | append: uid
-%}

<style>
  #{{ bar }} {
    --hl-icon-color: {{ section.settings.icon_color }};
    --hl-text-color: {{ section.settings.text_color }};
    --hl-star-color: {{ section.settings.star_color }};
    --hl-accent-color: {{ section.settings.accent_color }};
    background-color: {{ section.settings.bg_color }};
    {% if section.settings.font_family == 'serif' %}
      --hl-font: Georgia, 'Times New Roman', serif;
    {% else %}
      --hl-font: inherit;
    {% endif %}
  }

  {%- if section.settings.full_width -%}
  #{{ bar }} {
    width: 100vw;
    max-width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }
  {%- endif -%}

  #{{ bar }} .hl-benefits-bar {
    display: block;
    width: 100%;
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px 0;
  }

  #{{ bar }} .hl-benefits-bar-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.column_gap }}px;
  }

  #{{ bar }} .hl-benefits-bar-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2px;
  }

  #{{ bar }} .hl-benefits-bar-icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ bar }} .hl-benefits-bar-icon svg {
    width: 100%;
    height: 100%;
    stroke: var(--hl-icon-color);
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #{{ bar }} .hl-benefits-bar-title {
    font-size: {{ section.settings.benefit_size }}px;
    color: var(--hl-text-color);
    margin: 0;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.02em;
    font-family: var(--hl-font);
  }

  #{{ bar }} .hl-review-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 14px 20px {{ section.settings.padding_bottom }}px;
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
  }

  #{{ bar }} .hl-review-stars {
    display: flex;
    gap: 2px;
    margin-bottom: 8px;
  }

  #{{ bar }} .hl-review-star {
    width: {{ section.settings.star_size }}px;
    height: {{ section.settings.star_size }}px;
    fill: var(--hl-star-color);
  }

  #{{ bar }} .hl-review-text {
    font-size: {{ section.settings.review_size }}px;
    color: var(--hl-text-color);
    text-align: center;
    line-height: 1.5;
    margin: 0;
    font-family: var(--hl-font);
  }

  #{{ bar }} .hl-review-text strong,
  #{{ bar }} .hl-review-text b {
    color: var(--hl-accent-color);
    font-weight: 600;
  }

  #{{ bar }} .hl-review-text a {
    color: var(--hl-accent-color);
    font-weight: 600;
    text-decoration: none;
  }

  #{{ bar }} .hl-review-text a:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    #{{ bar }} .hl-benefits-bar {
      padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px;
    }
    #{{ bar }} .hl-benefits-bar-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: {{ section.settings.column_gap | minus: 3 }}px;
    }
    #{{ bar }} .hl-benefits-bar-icon {
      width: {{ section.settings.icon_size | plus: 2 }}px;
      height: {{ section.settings.icon_size | plus: 2 }}px;
    }
    #{{ bar }} .hl-benefits-bar-title {
      font-size: {{ section.settings.benefit_size | plus: 1 }}px;
    }
    #{{ bar }} .hl-review-star {
      width: {{ section.settings.star_size | minus: 5 }}px;
      height: {{ section.settings.star_size | minus: 5 }}px;
    }
    #{{ bar }} .hl-review-text {
      font-size: {{ section.settings.review_size | minus: 1 }}px;
    }
    #{{ bar }} .hl-review-bar {
      padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
    }
  }
</style>

<div id="{{ bar }}" class="hl-bar-outer">
  {%- if section.blocks.size > 0 -%}
    <div class="hl-benefits-bar">
      <div class="hl-benefits-bar-grid">
        {%- for block in section.blocks -%}
          <div class="hl-benefits-bar-item" {{ block.shopify_attributes }}>
            <div class="hl-benefits-bar-icon">
              {%- if block.settings.custom_icon != blank -%}
                {{ block.settings.custom_icon | image_url: width: 96 | image_tag: alt: block.settings.title, loading: 'lazy' }}
              {%- else -%}
                {%- case block.settings.icon -%}
                  {%- when 'heart' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                    </svg>
                  {%- when 'leaf' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                      <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
                    </svg>
                  {%- when 'heart-time' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                      <path d="M12 8v4l2 2"/>
                    </svg>
                  {%- when 'clock' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <circle cx="12" cy="12" r="10"/>
                      <path d="M12 6v6l4 2"/>
                    </svg>
                  {%- when 'shield' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                      <path d="m9 12 2 2 4-4"/>
                    </svg>
                  {%- when 'truck' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M1 3h13v13H1z"/>
                      <path d="M14 8h4l3 3v5h-7z"/>
                      <circle cx="5.5" cy="18.5" r="2.5"/>
                      <circle cx="17.5" cy="18.5" r="2.5"/>
                    </svg>
                  {%- when 'sparkle' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M12 3l1.9 5.6L19.5 10l-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4L12 3z"/>
                      <path d="M18.5 15.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8.8-2.2z"/>
                    </svg>
                  {%- when 'hand' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M18 11V6a2 2 0 0 0-4 0v5"/>
                      <path d="M14 10V4a2 2 0 0 0-4 0v7"/>
                      <path d="M10 10.5V6a2 2 0 0 0-4 0v9"/>
                      <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2a8 8 0 0 1-8-8"/>
                    </svg>
                  {%- when 'check' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <circle cx="12" cy="12" r="10"/>
                      <path d="m8 12 3 3 5-6"/>
                    </svg>
                  {%- when 'return' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M3 12a9 9 0 1 0 3-6.7"/>
                      <path d="M3 4v5h5"/>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}
              <p class="hl-benefits-bar-title">{{ block.settings.title | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_reviews -%}
    <div class="hl-review-bar">
      {%- if section.settings.star_count > 0 -%}
        <div class="hl-review-stars" role="img" aria-label="{{ section.settings.star_count }} out of 5 stars">
          {%- for i in (1..section.settings.star_count) -%}
            <svg class="hl-review-star" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if section.settings.review_text != blank -%}
        <p class="hl-review-text">{{ section.settings.review_text }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Benefits & review bar",
  "tag": "section",
  "class": "section section-benefits-review-bar",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Stretch background full width",
      "info": "Breaks out of the theme's max-width container.",
      "default": true
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Content width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Gap between items",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors and type"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#f8f4f0"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icons",
      "default": "#8a4b2b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#321004"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Stars",
      "default": "#db9d46"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Highlighted words",
      "info": "Applies to bold text and links inside the review line.",
      "default": "#06a26e"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        { "value": "serif", "label": "Georgia (serif)" },
        { "value": "theme", "label": "Theme font" }
      ],
      "default": "serif"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Icon size",
      "default": 22
    },
    {
      "type": "range",
      "id": "benefit_size",
      "min": 9,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Benefit text size",
      "default": 11
    },
    {
      "type": "header",
      "content": "Review bar"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show review line",
      "default": true
    },
    {
      "type": "range",
      "id": "star_count",
      "min": 0,
      "max": 5,
      "step": 1,
      "label": "Number of stars",
      "default": 5
    },
    {
      "type": "range",
      "id": "star_size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Star size",
      "default": 24
    },
    {
      "type": "inline_richtext",
      "id": "review_text",
      "label": "Review text",
      "info": "Bold a word or add a link to show it in the highlight color.",
      "default": "4.9/5 - Rated Excellent by 2,400+ verified buyers on <strong>Trustpilot</strong>"
    },
    {
      "type": "range",
      "id": "review_size",
      "min": 9,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Review text size",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "heart", "label": "Heart" },
            { "value": "heart-time", "label": "Heart with clock" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "clock", "label": "Clock" },
            { "value": "shield", "label": "Shield" },
            { "value": "check", "label": "Check circle" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "hand", "label": "Hand" },
            { "value": "truck", "label": "Delivery truck" },
            { "value": "return", "label": "Returns" }
          ],
          "default": "heart"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon",
          "info": "Optional. Replaces the icon above."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Text",
          "default": "HANDMADE BY HELEN"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Benefits & review bar",
      "blocks": [
        {
          "type": "benefit",
          "settings": { "icon": "heart", "title": "HANDMADE BY Eveline" }
        },
        {
          "type": "benefit",
          "settings": { "icon": "leaf", "title": "EASE STIFF JOINTS" }
        },
        {
          "type": "benefit",
          "settings": { "icon": "heart-time", "title": "BOOST CIRCULATION" }
        },
        {
          "type": "benefit",
          "settings": { "icon": "clock", "title": "99.9% PURE COPPER" }
        }
      ]
    }
  ]
}
{% endschema %}
